<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app's entitlements, named by CODE_SIGN_ENTITLEMENTS in both configurations. Kept outside
  Dirnex/ because that folder is a file-system-synchronized group, where a plist would be copied
  into the bundle as a resource.

  - Photos library (PLAN.md §M28): under the hardened runtime, PhotoKit access without this is denied
    in milliseconds with no prompt at all — measured 2026-09-13 against three signed variants
    (docs/NOTES.md ▸ iCloud Photos). It must ship together with NSPhotoLibraryUsageDescription, whose
    absence kills the process on its first PhotoKit call.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
</dict>
</plist>
