    "tour.ready.body" : {
      "comment" : "First-run tour screen 'tour.ready': body.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS schützt einige Ordner: die Benutzerordner anderer Personen, Mail und Time Machine-Backups. Gewähren Sie Festplattenvollzugriff, wenn Sie ihn zum ersten Mal brauchen. Sie können diese Tour jederzeit über die Befehlspalette erneut öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS keeps a few folders private — other users' homes, Mail, Time Machine backups. Grant Full Disk Access when you first need one. You can reopen this tour anytime from the command palette."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS mantiene privadas algunas carpetas: las carpetas de inicio de otros usuarios, Mail y las copias de Time Machine. Concede acceso total al disco cuando lo necesites por primera vez. Puedes volver a abrir este recorrido cuando quieras desde la paleta de comandos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS protège certains dossiers, notamment les dossiers de départ d’autres utilisateurs, Mail et les sauvegardes Time Machine. Accordez l’accès complet au disque lorsque vous en avez besoin. Vous pouvez rouvrir cette visite à tout moment depuis la palette de commandes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS tiene private alcune cartelle: le cartelle Inizio di altri utenti, Mail e i backup di Time Machine. Concedi Accesso completo al disco quando ne hai bisogno per la prima volta. Puoi riaprire questa guida in qualsiasi momento dalla palette dei comandi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSは一部のフォルダを非公開にしています。ほかのユーザのホーム、“メール”、Time Machineバックアップなどです。必要になったときにフルディスクアクセスを許可してください。このツアーはコマンドパレットからいつでも開き直せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS는 다른 사용자의 홈 폴더, Mail, Time Machine 백업 같은 일부 폴더를 비공개로 유지합니다. 처음 필요할 때 전체 디스크 접근 권한을 허용하십시오. 이 둘러보기는 명령 팔레트에서 언제든지 다시 열 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "macOS houdt een paar mappen privé — de thuismappen van andere gebruikers, Mail en Time Machine-back-ups. Geef Volledige schijftoegang wanneer je er voor het eerst een nodig hebt. Je kunt deze tour op elk moment opnieuw openen vanuit het opdrachtenpalet.",
            "state" : "translated"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS trzyma kilka folderów prywatnie — foldery domowe innych użytkowników, Mail, kopie Time Machine. Przyznaj Pełny dostęp do dysku, gdy pierwszy raz go potrzebujesz. Do tego wprowadzenia możesz wrócić z palety poleceń."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS держит несколько папок закрытыми — домашние папки других пользователей, Почту, резервные копии Time Machine. Предоставьте полный доступ к диску, когда он впервые понадобится. Этот обзор можно снова открыть в любой момент из палитры команд."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть папку в кожній панелі й починайте. Усі параметри можна змінити пізніше."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS mantém algumas pastas privadas: pastas de outros usuários, Mail e backups do Time Machine. Conceda Acesso Total ao Disco quando precisar de uma delas pela primeira vez. Você pode reabrir este tour a qualquer momento pela paleta de comandos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 会保护少数文件夹，例如其他用户的个人文件夹、邮件和 Time Machine 备份。首次需要访问时，请授予完全磁盘访问权限。你随时可以从命令面板重新打开此导览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 會保護少數檔案夾，例如其他使用者的個人檔案夾、郵件和 Time Machine 備份。首次需要取用時，請授予「完全取用磁碟」權限。你隨時可以從指令面板重新打開此導覽。"
          }
        }
      }
    },
