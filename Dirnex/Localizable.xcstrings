                  "value" : "Метка будет снята с %lld файлов во всех местах, проиндексированных Spotlight. Сами файлы не удаляются."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Метка будет снята с %lld файлов во всех местах, проиндексированных Spotlight. Сами файлы не удаляются."
                }
              },
              "one" : {
