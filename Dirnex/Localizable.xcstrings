    "Brings Dirnex's active panel to a file or folder and selects it, like Finder's Reveal." : {
      "comment" : "Shortcuts action description for Reveal in Dirnex.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brings Dirnex's active panel to a file or folder and selects it, like Finder's Reveal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre le dossier du fichier ou dossier indiqué dans le panneau actif de Dirnex et le sélectionne, comme la commande Afficher dans le Finder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает папку с файлом в активной панели Dirnex и ставит на него курсор — как «Показать в Finder»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva el panel activo de Dirnex a un archivo o una carpeta y lo selecciona, como Revelar en Finder."
          }
        }
      }
    },
    "Browse a remote SFTP or FTP account, or an SMB share on your network." : {
      "comment" : "Subtitle of the Connect to Server dialog.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
