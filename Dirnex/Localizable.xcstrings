    "All your shortcut customizations will be removed and the macOS defaults restored. All your changes will be lost." : {
      "comment" : "Shortcuts: restore-defaults confirmation body.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All your shortcut customizations will be removed and the macOS defaults restored. All your changes will be lost."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes vos personnalisations de raccourcis seront supprimées et les raccourcis macOS par défaut seront restaurés. Toutes vos modifications seront perdues."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все ваши изменения сочетаний клавиш будут удалены и восстановлены стандартные значения macOS. Все изменения будут потеряны."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todas tus personalizaciones de funciones rápidas y se restaurarán los valores por omisión de macOS. Se perderán todos tus cambios."
          }
        }
      }
    },
