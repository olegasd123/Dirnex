    "tour.palette.body" : {
      "comment" : "First-run tour screen 'tour.palette': body.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie die Befehlspalette und geben Sie ein, was Sie tun möchten: kopieren, komprimieren, mit einem Server verbinden, taggen. Die Suche findet auch ähnliche Aktionstitel, sodass Sie nichts auswendig lernen und kein Menü durchsuchen müssen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the command palette and start typing what you want to do — copy, pack, connect to a server, tag. It fuzzy-matches every action, so there's nothing to memorize and no menu to hunt through."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la paleta de comandos y empieza a escribir lo que quieres hacer: copiar, comprimir, conectar a un servidor, etiquetar. Encuentra cada acción con coincidencia aproximada, así que no hay nada que memorizar ni menús que recorrer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez la palette de commandes et saisissez ce que vous voulez faire : copier, créer une archive, vous connecter à un serveur ou ajouter une étiquette. Elle recherche approximativement chaque action ; rien à mémoriser, aucun menu à parcourir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri la palette dei comandi e inizia a digitare ciò che vuoi fare: copia, archivia, connettiti a un server, aggiungi tag. La ricerca trova le azioni anche con parole simili, quindi non c’è niente da memorizzare e nessun menu da cercare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンドパレットを開き、コピー、圧縮、サーバへ接続、タグ付けなど、実行したいことを入力してください。すべてのアクションをあいまい検索するため、覚える必要もメニューを探す必要もありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령 팔레트를 열고 복사, 압축, 서버 연결, 태그처럼 하려는 작업을 입력하십시오. 모든 동작을 퍼지 검색하므로 외울 필요도, 메뉴를 찾을 필요도 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open het opdrachtenpalet en begin te typen wat je wilt doen — kopiëren, inpakken, verbinding maken met een server, taggen. Het zoekt flexibel in alle acties, dus je hoeft niets te onthouden en geen menu te doorzoeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz paletę poleceń i zacznij pisać, co chcesz zrobić — kopiować, pakować, połączyć się z serwerem, dodać tag. Dopasowuje każdą akcję, więc nie trzeba nic zapamiętywać ani szukać w menu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте палитру команд и начните вводить, что хотите сделать — копировать, упаковать, подключиться к серверу, поставить тег. Она находит любое действие по нечёткому совпадению, так что ничего не нужно запоминать и не нужно искать по меню."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть ⌘K, щоб знайти будь-яку команду або скрипт за назвою. Це найшвидший шлях до дій, які не мають клавіші."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra a paleta de comandos e comece a digitar o que você quer fazer: copiar, compactar, conectar a um servidor, adicionar etiqueta. Ela encontra ações de forma aproximada, então não há nada para memorizar nem menu para procurar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开命令面板，然后输入想做的事：拷贝、压缩、连接服务器、标记。它会模糊匹配每个操作，所以不需要记忆，也不用在菜单里寻找。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開指令面板，然後輸入想做的事：拷貝、壓縮、連接伺服器、標記。它會模糊比對每個操作，所以不需要記憶，也不用在選單裡尋找。"
          }
        }
      }
    },
