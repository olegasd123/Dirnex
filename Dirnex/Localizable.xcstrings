    "Something with the same name is in the original folder, so it was left in the Trash rather than replaced." : {
      "comment" : "Put-Back detail: a name collision blocked the restore.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im ursprünglichen Ordner befindet sich bereits ein Objekt mit demselben Namen. Daher wurde es im Papierkorb gelassen und nicht ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something with the same name is in the original folder, so it was left in the Trash rather than replaced."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay algo con el mismo nombre en la carpeta original, así que se dejó en la papelera en lugar de reemplazarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un élément portant le même nom se trouve dans le dossier d’origine ; l’élément dans la corbeille n’a donc pas été remplacé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un elemento con lo stesso nome si trova nella cartella originale, quindi è stato lasciato nel Cestino invece di essere sostituito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元のフォルダに同じ名前の項目があるため、置き換えずにゴミ箱に残しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원래 폴더에 같은 이름의 항목이 있어서 대치하지 않고 휴지통에 그대로 두었습니다."
