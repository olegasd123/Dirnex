    "That file has no location on disk, so there is nothing to reveal." : {
      "comment" : "Shortcuts error when the file handed to Reveal in Dirnex is not on disk.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei hat keinen lokalen Speicherort, daher gibt es nichts anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That file has no location on disk, so there is nothing to reveal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese archivo no tiene ubicación en el disco, así que no hay nada que revelar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier n’a pas d’emplacement sur le disque ; il n’y a donc rien à révéler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quel file non ha una posizione sul disco, quindi non c’è niente da mostrare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのファイルにはディスク上の場所がないため、表示するものはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 파일에는 디스크 위치가 없어 표시할 항목이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Dat bestand heeft geen locatie op de schijf, dus er is niets om te tonen.",
            "state" : "translated"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten plik nie ma położenia na dysku, więc nie ma czego pokazać."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У этого файла нет расположения на диске — показывать нечего."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей файл не має розташування на диску, тому нічого показати."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse arquivo não tem um local no disco, então não há nada para revelar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该文件在磁盘上没有位置，所以没有可显示的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該檔案在磁碟上沒有位置，所以沒有可顯示的內容。"
          }
        }
      }
    },
