        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось пройти аутентификацию. Проверьте имя пользователя и пароль или попробуйте гостевое подключение."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося пройти автентифікацію. Перевірте ім’я користувача й пароль або спробуйте гостьове з’єднання."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A autenticação falhou. Verifique o nome de usuário e a senha, ou tente uma conexão como convidado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
