    "You can browse every folder on this Mac. To change this, open Full Disk Access in System Settings." : {
      "comment" : "FDA already-granted sheet body.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können jeden Ordner auf diesem Mac durchsuchen. Um dies zu ändern, öffnen Sie „Festplattenvollzugriff“ in den Systemeinstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can browse every folder on this Mac. To change this, open Full Disk Access in System Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes explorar todas las carpetas de este Mac. Para cambiar esto, abre Acceso total al disco en Ajustes del Sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez parcourir tous les dossiers de ce Mac. Pour modifier cela, ouvrez Accès complet au disque dans Réglages Système."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете просматривать любую папку на этом Mac. Чтобы изменить это, откройте «Полный доступ к диску» в Системных настройках."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode navegar por todas as pastas deste Mac. Para alterar isso, abra Acesso Total ao Disco em Ajustes do Sistema."
          }
        }
      }
    },
    "You can restore items from the Trash later." : {
      "comment" : "Trash confirmation body.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Objekte später aus dem Papierkorb wiederherstellen."
          }
        },
        "en" : {
