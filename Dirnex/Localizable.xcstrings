    "vfs.unsupported.archiveAddFailed" : {
      "comment" : "Why an operation is unsupported; DirnexCore data (VFSUnsupportedReason), keyed by the reason's stable case name. Shown under the alert title in every file-op and load failure. %1$@ is the item, %2$@ the archive.",
