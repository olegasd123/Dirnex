    "Authentication failed. Check the username and password, or try a guest connection." : {
      "comment" : "SMB mount failure: the server rejected the credentials.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentifizierung fehlgeschlagen. Prüfen Sie Benutzername und Passwort oder versuchen Sie eine Gastverbindung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentication failed. Check the username and password, or try a guest connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La autenticación falló. Revisa el nombre de usuario y la contraseña, o prueba una conexión como invitado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’authentification a échoué. Vérifiez le nom d’utilisateur et le mot de passe, ou essayez une connexion d’invité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autenticazione non riuscita. Controlla il nome utente e la password o prova una connessione come ospite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認証に失敗しました。ユーザ名とパスワードを確認するか、ゲスト接続を試してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인증에 실패했습니다. 사용자 이름과 암호를 확인하거나 게스트 연결을 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Verificatie mislukt. Controleer de gebruikersnaam en het wachtwoord, of probeer een gastverbinding.",
            "state" : "translated"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwierzytelnianie nie powiodło się. Sprawdź nazwę użytkownika i hasło albo spróbuj połączenia jako gość."
