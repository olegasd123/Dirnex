        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер отказал в доступе к этому пути."
          }
        }
      }
    },
    "The server stopped responding." : {
      "comment" : "FTP connect failure detail: the operation exceeded its time budget.",
      "localizations" : {
