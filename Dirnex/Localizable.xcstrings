                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Il sera supprimé des fichiers %lld, partout où Spotlight a indexé. Les fichiers eux-mêmes ne sont pas supprimés."
                }
              }
            }
          }
        },
        "ru" : {
          "variations" : {
            "plural" : {
