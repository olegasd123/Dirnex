    "It will be removed from %lld files, everywhere Spotlight has indexed. The files themselves aren’t deleted." : {
      "comment" : "Body of the delete-tag confirmation; %lld is how many files carry the tag.",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Das Tag wird aus %lld Datei entfernt, überall dort, wo Spotlight sie indexiert hat. Die Datei selbst wird nicht gelöscht."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Das Tag wird aus %lld Dateien entfernt, überall dort, wo Spotlight sie indexiert hat. Die Dateien selbst werden nicht gelöscht."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
