    "tour.welcome.body" : {
      "comment" : "First-run tour screen 'tour.welcome': body.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two panels, side by side, driven from the keyboard. One holds the files you're working with, the other where they're going — and you reach for the mouse only when you want to."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux panneaux, côte à côte, commandés depuis le clavier. L’un contient les fichiers avec lesquels vous travaillez, l’autre leur destination — et vous ne prenez la souris que lorsque vous le souhaitez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Две панели рядом, управляемые с клавиатуры. В одной — файлы, с которыми вы работаете, в другой — куда они отправляются, а к мыши вы тянетесь, только когда сами захотите."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos paneles, uno al lado del otro, controlados con el teclado. Uno contiene los archivos con los que trabajas; el otro, el lugar al que van. Usa el ratón solo cuando quieras."
          }
        }
      }
    },
