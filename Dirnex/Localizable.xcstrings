    "Permission denied. Check the username and that the key is authorized on the server." : {
      "comment" : "SFTP connect failure detail: authentication was rejected.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff verweigert. Prüfen Sie den Benutzernamen und ob der Schlüssel auf dem Server zugelassen ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permission denied. Check the username and that the key is authorized on the server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permiso denegado. Revisa el nombre de usuario y que la clave esté autorizada en el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisation refusée. Vérifiez le nom d’utilisateur et assurez-vous que la clé est autorisée sur le serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permesso negato. Controlla il nome utente e assicurati che la chiave sia autorizzata sul server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "権限が拒否されました。ユーザ名と、そのキーがサーバで許可されているかを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한이 거부되었습니다. 사용자 이름과 키가 서버에서 허용되었는지 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toestemming geweigerd. Controleer het gebruikersnaam en zorg ervoor dat de sleutel is geautoriseerd op de server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odmowa dostępu. Sprawdź nazwę użytkownika i czy klucz jest autoryzowany na serwerze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отказано в доступе. Проверьте имя пользователя и то, что ключ авторизован на сервере."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
