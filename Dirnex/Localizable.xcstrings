    "It will be removed from %lld files, everywhere Spotlight has indexed. The files themselves aren’t deleted." : {
      "comment" : "Body of the delete-tag confirmation; %lld is how many files carry the tag.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "It will be removed from %lld file, everywhere Spotlight has indexed. The files themselves aren’t deleted."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "It will be removed from %lld files, everywhere Spotlight has indexed. The files themselves aren’t deleted."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
