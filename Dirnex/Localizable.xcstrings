        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz przeglądać każdy folder na tym Macu. Aby to zmienić, otwórz Pełny dostęp do dysku w Ustawieniach systemowych."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете просматривать любую папку на этом Mac. Чтобы изменить это, откройте «Полный доступ к диску» в Системных настройках."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви можете переглядати кожну папку на цьому Mac. Щоб змінити це, відкрийте «Повний доступ до диска» в Системних параметрах."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode navegar por todas as pastas deste Mac. Para alterar isso, abra Acesso Total ao Disco em Ajustes do Sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以浏览此 Mac 上的每个文件夹。要更改此设置，请在“系统设置”中打开“完全磁盘访问权限”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以瀏覽此 Mac 上的每個檔案夾。要變更此設定，請在「系統設定」中打開「完全取用磁碟」。"
          }
        }
      }
    },
    "You can restore items from the Trash later." : {
      "comment" : "Trash confirmation body.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Objekte später aus dem Papierkorb wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
