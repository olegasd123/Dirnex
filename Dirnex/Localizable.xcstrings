    "You don’t have permission. Dirnex may need Full Disk Access in System Settings." : {
      "comment" : "Error sentence: permission denied.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben keine Berechtigung. Dirnex benötigt möglicherweise Festplattenvollzugriff in den Systemeinstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don’t have permission. Dirnex may need Full Disk Access in System Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes permiso. Es posible que Dirnex necesite acceso total al disco en Ajustes del Sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas l’autorisation. Dirnex peut nécessiter l’accès complet au disque dans Réglages Système."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai il permesso. Dirnex potrebbe richiedere Accesso completo al disco in Impostazioni di Sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "権限がありません。Dirnexには“システム設定”でフルディスクアクセスが必要な可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "권한이 없습니다. 시스템 설정에서 Dirnex에 전체 디스크 접근 권한을 허용해야 할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt geen toestemming. Dirnex heeft mogelijk Volledige schijftoegang nodig in Systeeminstellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie masz uprawnień. Dirnex może potrzebować Pełnego dostępu do dysku w Ustawieniach systemowych."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недостаточно прав. Возможно, Dirnex нужен полный доступ к диску в Системных настройках."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас немає дозволу. Dirnex може потребувати Повного доступу до диска в Системних параметрах."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não tem permissão. O Dirnex pode precisar de Acesso Total ao Disco em Ajustes do Sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你没有权限。Dirnex 可能需要在“系统设置”中获得完全磁盘访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你沒有權限。Dirnex 可能需要在「系統設定」中獲得「完全取用磁碟」權限。"
          }
        }
      }
    },
    "Your customized shortcuts will be replaced by the %@ preset. All your changes will be lost." : {
      "comment" : "Shortcuts: preset-switch confirmation body. %@ is a preset name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre angepassten Tastaturkurzbefehle werden durch die Voreinstellung „%@“ ersetzt. Alle Änderungen gehen verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your customized shortcuts will be replaced by the %@ preset. All your changes will be lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus funciones rápidas personalizadas se reemplazarán por el preajuste %@. Se perderán todos tus cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos raccourcis personnalisés seront remplacés par le préréglage %@. Toutes vos modifications seront perdues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue abbreviazioni da tastiera personalizzate verranno sostituite dalla preimpostazione %@. Tutte le modifiche andranno perse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタマイズしたショートカットは%@プリセットで置き換えられます。すべての変更が失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자화한 단축키가 %@ 프리셋으로 대치됩니다. 모든 변경 사항이 사라집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Je aangepaste toetscombinaties worden vervangen door de voorinstelling %@. Al je wijzigingen gaan verloren.",
            "state" : "translated"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Własne skróty zostaną zastąpione zestawem %@. Wszystkie zmiany zostaną utracone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши настроенные сочетания клавиш будут заменены набором «%@». Все изменения будут потеряны."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші власні скорочення буде замінено набором %@. Усі зміни буде втрачено."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus atalhos personalizados serão substituídos pela predefinição %@. Todas as suas alterações serão perdidas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的自定义快捷键将被 %@ 预设替换。你所有的更改将丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的自訂快速鍵將由 %@ 預設取代。你所有的變更將遺失。"
          }
        }
      }
    },
    "Your files in iCloud Drive are listed above. The folders apps keep there — Pages, Preview, Shortcuts — are private to macOS until you allow Dirnex to read them.\n\nClick Open System Settings, then switch on Dirnex under Full Disk Access. macOS will ask Dirnex to relaunch so the new access takes effect." : {
      "comment" : "FDA (iCloud) sheet body.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Dateien in iCloud Drive sind oben aufgeführt. Die Ordner, die Apps dort ablegen – Pages, Vorschau, Kurzbefehle – sind für macOS privat, bis Sie Dirnex den Lesezugriff erlauben.\n\nKlicken Sie auf „Systemeinstellungen öffnen“ und aktivieren Sie Dirnex unter „Festplattenvollzugriff“. macOS fordert dann einen Neustart von Dirnex an, damit der neue Zugriff wirksam wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your files in iCloud Drive are listed above. The folders apps keep there — Pages, Preview, Shortcuts — are private to macOS until you allow Dirnex to read them.\n\nClick Open System Settings, then switch on Dirnex under Full Disk Access. macOS will ask Dirnex to relaunch so the new access takes effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus archivos de iCloud Drive aparecen arriba. Las carpetas que las apps guardan allí —Pages, Vista Previa y Atajos— son privadas para macOS hasta que permitas que Dirnex las lea.\n\nHaz clic en Abrir Ajustes del Sistema y activa Dirnex en Acceso total al disco. macOS pedirá reiniciar Dirnex para que el nuevo acceso surta efecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos fichiers iCloud Drive sont affichés ci-dessus. Les dossiers que les apps y créent — Pages, Aperçu, Raccourcis — sont privés dans macOS jusqu’à ce que vous autorisiez Dirnex à les lire.\n\nCliquez sur Ouvrir Réglages Système, puis activez Dirnex dans Accès complet au disque. macOS vous demandera de relancer Dirnex afin que l’autorisation prenne effet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file in iCloud Drive sono elencati sopra. Le cartelle che le app conservano lì, come Pages, Anteprima e Comandi Rapidi, restano private per macOS finché non autorizzi Dirnex a leggerle.\n\nFai clic su Apri Impostazioni di Sistema, poi attiva Dirnex in Accesso completo al disco. macOS chiederà a Dirnex di riavviarsi perché il nuovo accesso abbia effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive内のファイルは上に表示されています。Pages、プレビュー、ショートカットなどのアプリがそこに置くフォルダは、Dirnexに読み取りを許可するまでmacOSにより非公開です。\n\n“システム設定を開く”をクリックして、“フルディスクアクセス”でDirnexをオンにしてください。新しいアクセス権を有効にするため、macOSからDirnexの再起動を求められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive의 파일이 위에 나열되어 있습니다. Pages, 미리보기, 단축어 같은 앱 폴더는 Dirnex가 읽도록 허용하기 전까지 macOS에서 비공개로 유지됩니다.\n\n‘시스템 설정 열기’를 클릭한 다음, 전체 디스크 접근 권한에서 Dirnex를 켜십시오. macOS가 새 권한을 적용하기 위해 Dirnex를 다시 실행하라고 요청합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Je bestanden in iCloud Drive staan hierboven. De mappen die apps daar bewaren — Pages, Voorvertoning, Opdrachten — zijn privé voor macOS totdat je Dirnex toestemming geeft om ze te lezen.\n\nKlik op Open Systeeminstellingen en schakel Dirnex in onder Volledige schijftoegang. macOS vraagt Dirnex om opnieuw te starten zodat de nieuwe toegang actief wordt.",
            "state" : "translated"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje pliki w iCloud Drive są pokazane wyżej. Foldery, które aplikacje tam trzymają — Pages, Podgląd, Skróty — są prywatne dla macOS, dopóki nie pozwolisz Dirnex ich odczytywać.\n\nKliknij Otwórz Ustawienia systemowe, a potem włącz Dirnex w sekcji Pełny dostęp do dysku. macOS poprosi o ponowne uruchomienie Dirnex, aby nowy dostęp zaczął działać."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши файлы в iCloud Drive показаны выше. Папки, которые там хранят приложения — Pages, «Просмотр», «Быстрые команды» — закрыты macOS, пока вы не разрешите Dirnex их читать.\n\nНажмите «Открыть Системные настройки», затем включите Dirnex в разделе «Полный доступ к диску». macOS попросит Dirnex перезапуститься, чтобы новый доступ вступил в силу."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші файли в iCloud Drive показано вище. Папки, які програми зберігають там — Pages, Preview, Shortcuts — приватні для macOS, доки ви не дозволите Dirnex читати їх.\n\nНатисніть «Відкрити Системні параметри», а потім увімкніть Dirnex у розділі «Повний доступ до диска». macOS попросить перезапустити Dirnex, щоб новий доступ набув чинності."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus arquivos no iCloud Drive estão listados acima. As pastas que os apps mantêm ali — Pages, Pré-Visualização, Atalhos — são privadas para o macOS até você permitir que o Dirnex as leia.\n\nClique em Abrir Ajustes do Sistema e ative o Dirnex em Acesso Total ao Disco. O macOS pedirá para o Dirnex reiniciar para que o novo acesso tenha efeito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
