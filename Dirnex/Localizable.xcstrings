          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos paneles deben mostrar una carpeta real en el disco."
          }
        }
      }
    },
    "Branch %@" : {
      "comment" : "Git branch tooltip; %@ is the branch name.",
