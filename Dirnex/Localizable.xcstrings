    "tour.files.body" : {
      "comment" : "First-run tour screen 'tour.files': body.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der aktive Bereich ist die Quelle, der andere das Ziel. Kopieren oder verschieben Sie die Auswahl, erstellen Sie einen Ordner oder legen Sie Dateien in den Papierkorb – über die Tasten unten, die Funktionstasten oder die Palette."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The active panel is the source, the other the destination. Copy or move what's selected across, make a folder, or send files to the Trash — from the buttons along the bottom, the function keys, or the palette."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El panel activo es el origen y el otro, el destino. Copia o mueve lo seleccionado, crea una carpeta o envía archivos a la papelera desde los botones de la parte inferior, las teclas de función o la paleta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le panneau actif est la source, l’autre la destination. Copiez ou déplacez les éléments sélectionnés, créez un dossier ou placez des fichiers dans la corbeille depuis les boutons du bas, les touches de fonction ou la palette."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pannello attivo è l’origine, l’altro è la destinazione. Copia o sposta gli elementi selezionati, crea una cartella o sposta i file nel Cestino usando i pulsanti in basso, i tasti funzione o la palette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティブなパネルがコピー元で、もう一方がコピー先です。下部のボタン、ファンクションキー、またはパレットから、選択項目をコピーまたは移動したり、フォルダを作成したり、ファイルをゴミ箱へ送ったりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성 패널은 출발지이고 다른 패널은 대상입니다. 아래쪽 버튼, 기능 키 또는 팔레트에서 선택 항목을 복사하거나 이동하고, 폴더를 만들고, 파일을 휴지통으로 보낼 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Het actieve paneel is de bron, het andere paneel is het doel. Kopieer of verplaats de selectie naar de andere kant, maak een map of verplaats bestanden naar de prullenmand — via de knoppen onderaan, de functietoetsen of het palet.",
            "state" : "translated"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywny panel jest źródłem, a drugi miejscem docelowym. Kopiuj lub przenoś zaznaczone rzeczy, twórz foldery albo przenoś pliki do Kosza — przyciskami na dole, klawiszami funkcyjnymi lub z palety."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активная панель — источник, другая — назначение. Копируйте или перемещайте выбранное между ними, создавайте папку или отправляйте файлы в Корзину — кнопками внизу, функциональными клавишами или через палитру."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дві панелі завжди готові. Виберіть файли, натисніть F5, щоб копіювати, F6, щоб перемістити, або F8, щоб перемістити в Кошик."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O painel ativo é a origem, e o outro é o destino. Copie ou mova a seleção, crie uma pasta ou envie arquivos para o Lixo pelos botões na parte inferior, pelas teclas de função ou pela paleta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前面板是来源，另一面板是目的地。你可以用底部按钮、功能键或命令面板拷贝或移动所选项目、创建文件夹，或将文件移到废纸篓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前面板是來源，另一面板是目的地。你可以用底部按鈕、功能鍵或指令面板拷貝或移動所選項目、建立檔案夾，或將檔案移至垃圾桶。"
          }
        }
      }
    },
