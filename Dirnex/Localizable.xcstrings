        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Skript ist weiterhin über die ⌘K-Palette und das Untermenü „Skripte“ verfügbar. Weisen Sie ihm unter „Skripte verwalten“ eine freie Taste zu, um den Tastaturkurzbefehl wiederherzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
