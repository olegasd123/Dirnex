        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selection is passed as arguments (\"$@\", \"$1\"). Also available: $DIRNEX_CURRENT_DIR, $DIRNEX_OTHER_DIR, $DIRNEX_SELECTED_PATHS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sélection est transmise en tant qu'arguments (\"$@\", \"$1\"). Disponible également : $DIRNEX_CURRENT_DIR, $DIRNEX_OTHER_DIR, $DIRNEX_SELECTED_PATHS."
          }
