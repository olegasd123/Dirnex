    "Login failed. Check the user name and password." : {
      "comment" : "FTP connect failure detail: authentication was rejected.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmeldung fehlgeschlagen. Prüfen Sie Benutzername und Passwort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Login failed. Check the user name and password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión falló. Revisa el nombre de usuario y la contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexion échouée. Vérifiez le nom d’utilisateur et le mot de passe."
          }
        },
        "it" : {
