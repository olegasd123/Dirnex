    "tour.navigate.body" : {
      "comment" : "First-run tour screen 'tour.navigate': body.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Springen Sie direkt zu einem Pfad, öffnen Sie einen zweiten Tab oder heften Sie häufig genutzte Ordner an. Orte, Tabs und Favoriten halten auch tiefe Verzeichnisbäume nur einen Tastendruck entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jump straight to a path, open a second tab, or pin the folders you live in. Location, tabs, and Favorites keep even a deep folder tree a single keystroke away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta directamente a una ruta, abre una segunda pestaña o fija las carpetas que usas a diario. Ubicación, pestañas y Favoritos mantienen incluso una carpeta muy profunda a una sola pulsación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accédez directement à un chemin, ouvrez un second onglet ou épinglez les dossiers que vous utilisez souvent. L’emplacement, les onglets et les favoris gardent même une arborescence profonde à une seule touche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai direttamente a un percorso, apri una seconda scheda o aggiungi le cartelle che usi spesso. Posizione, schede e Preferiti tengono anche alberi di cartelle profondi a portata di tasto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスへ直接移動したり、2つ目のタブを開いたり、よく使うフォルダをピン留めしたりできます。“場所”、タブ、“お気に入り”を使えば、深いフォルダツリーにも1回のキー操作で届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경로로 바로 이동하거나, 두 번째 탭을 열거나, 자주 쓰는 폴더를 고정하십시오. 위치, 탭, 즐겨찾기를 사용하면 깊은 폴더도 키 한 번으로 열 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spring rechtstreeks naar een pad, open een tweede tabblad of bevestig de mappen waarin je woont. Locatie, tabbladen en Favorieten houden zelfs een diepe mappenboom op één tik afstand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przejdź od razu do ścieżki, otwórz drugą kartę albo przypnij foldery, w których pracujesz. Położenia, karty i Ulubione trzymają nawet głębokie drzewo folderów o jedno naciśnięcie klawisza stąd."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переходите сразу к пути, открывайте вторую вкладку или закрепляйте папки, в которых живёте. Переход к пути, вкладки и Избранное держат даже глубокое дерево папок в одном нажатии клавиши."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте клавіші зі стрілками, Return і Backspace, щоб швидко переходити між папками. Кожна панель має власні вкладки й історію."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vá direto para um caminho, abra uma segunda aba ou fixe as pastas que você mais usa. Local, abas e Favoritos deixam até uma árvore de pastas profunda a um atalho de distância."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接跳到路径、打开第二个标签页，或固定常用文件夹。位置、标签页和个人收藏让很深的文件夹也只需一次按键即可到达。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接跳到路徑、打開第二個標籤頁，或固定常用檔案夾。位置、標籤頁和喜好項目讓很深的檔案夾也只需一次按鍵即可到達。"
          }
        }
      }
    },
