    "tour.welcome.body" : {
      "comment" : "First-run tour screen 'tour.welcome': body.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Bereiche nebeneinander, gesteuert über die Tastatur. Einer enthält die Dateien, mit denen Sie arbeiten; der andere zeigt, wohin sie gehen. Zur Maus greifen Sie nur, wenn Sie möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two panels, side by side, driven from the keyboard. One holds the files you're working with, the other where they're going — and you reach for the mouse only when you want to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos paneles, uno al lado del otro, controlados con el teclado. Uno contiene los archivos con los que trabajas; el otro, el lugar al que van. Usa el ratón solo cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux panneaux, côte à côte, commandés depuis le clavier. L’un contient les fichiers avec lesquels vous travaillez, l’autre leur destination — et vous ne prenez la souris que lorsque vous le souhaitez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due pannelli, uno accanto all’altro, gestiti dalla tastiera. Uno contiene i file con cui stai lavorando, l’altro la loro destinazione. Usa il mouse solo quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "横に並んだ2つのパネルをキーボードで操作します。片方には作業中のファイル、もう片方には移動先を表示します。マウスは必要なときだけ使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키보드로 다루는 두 패널이 나란히 있습니다. 한쪽에는 작업할 파일이 있고, 다른 한쪽에는 보낼 위치가 있습니다. 필요할 때만 마우스를 사용하면 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Twee panelen, naast elkaar, aangedreven vanaf het toetsenbord. Het ene bevat de bestanden waarmee je werkt, het andere waar ze naartoe gaan — en je reikt alleen naar de muis als je dat wilt.",
            "state" : "translated"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dwa panele obok siebie, sterowane z klawiatury. Jeden trzyma pliki, z którymi pracujesz, drugi miejsce, do którego trafią — po mysz sięgasz tylko wtedy, kiedy chcesz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Две панели рядом, управляемые с клавиатуры. В одной — файлы, с которыми вы работаете, в другой — куда они отправляются, а к мыши вы тянетесь, только когда сами захотите."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dirnex — двопанельний файловий менеджер для macOS, створений для швидкої роботи з клавіатури."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dois painéis, lado a lado, controlados pelo teclado. Um fica com os arquivos em que você está trabalhando; o outro, com o destino deles. Você só usa o mouse quando quiser."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两个面板并排显示，并以键盘驱动。一个放你正在处理的文件，另一个放它们要去的位置；只有需要时才使用鼠标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩個面板並排顯示，並以鍵盤驅動。一個放你正在處理的檔案，另一個放它們要去的位置；只有需要時才使用滑鼠。"
          }
        }
      }
    },
