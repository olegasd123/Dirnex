    "tour.files.body" : {
      "comment" : "First-run tour screen 'tour.files': body.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The active panel is the source, the other the destination. Copy or move what's selected across, make a folder, or send files to the Trash — from the buttons along the bottom, the function keys, or the palette."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le panneau actif est la source, l’autre la destination. Copiez ou déplacez les éléments sélectionnés, créez un dossier ou placez des fichiers dans la corbeille depuis les boutons du bas, les touches de fonction ou la palette."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Активная панель — источник, другая — назначение. Копируйте или перемещайте выбранное между ними, создавайте папку или отправляйте файлы в Корзину — кнопками внизу, функциональными клавишами или через палитру."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El panel activo es el origen y el otro, el destino. Copia o mueve lo seleccionado, crea una carpeta o envía archivos a la papelera desde los botones de la parte inferior, las teclas de función o la paleta."
          }
        }
      }
    },
    "tour.files.title" : {
      "comment" : "First-run tour screen 'tour.files': title.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move files between panels"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacer des fichiers entre les panneaux"
          }
        },
        "ru" : {
