          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permissão negada. Verifique o nome de usuário e se a chave está autorizada no servidor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "权限被拒绝。请检查用户名，并确认该密钥在服务器上已授权。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
