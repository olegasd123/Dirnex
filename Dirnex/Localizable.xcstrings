            "state" : "translated",
            "value" : "工作區名稱"
          }
        }
      }
    },
    "You can browse every folder on this Mac. To change this, open Full Disk Access in System Settings." : {
      "comment" : "FDA already-granted sheet body.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können jeden Ordner auf diesem Mac durchsuchen. Um dies zu ändern, öffnen Sie „Festplattenvollzugriff“ in den Systemeinstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can browse every folder on this Mac. To change this, open Full Disk Access in System Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes explorar todas las carpetas de este Mac. Para cambiar esto, abre Acceso total al disco en Ajustes del Sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
