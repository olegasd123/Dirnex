    },
    "You can browse every folder on this Mac. To change this, open Full Disk Access in System Settings." : {
      "comment" : "FDA already-granted sheet body.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can browse every folder on this Mac. To change this, open Full Disk Access in System Settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez parcourir tous les dossiers de ce Mac. Pour modifier cela, ouvrez l'accès complet au disque dans les paramètres système."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете просматривать любую папку на этом Mac. Чтобы изменить это, откройте «Полный доступ к диску» в Системных настройках."
          }
        }
      }
    },
    "You can restore items from the Trash later." : {
      "comment" : "Trash confirmation body.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
