          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показать\/скрыть боковую панель"
          }
        }
      }
    },
    "Tokens:  [N] name   [E] extension   [C] counter   [Y] [M] [D] date   [h] [n] [s] time" : {
      "comment" : "Multi-rename token legend; bracketed tokens are literal mask syntax and never translate.",
      "localizations" : {
