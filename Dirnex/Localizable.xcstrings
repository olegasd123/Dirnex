    "The server’s certificate couldn’t be read, so it can’t be trusted safely." : {
      "comment" : "FTP connect failure detail: the certificate's public key could not be parsed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zertifikat des Servers konnte nicht gelesen werden und kann daher nicht sicher als vertrauenswürdig eingestuft werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
