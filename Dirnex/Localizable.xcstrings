          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La herramienta Comparar por contenido (⌥F3) abre los dos archivos en la app seleccionada. Instaladas: %@. Automático elige la primera que siga instalada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’outil Comparer le contenu (⌥F3) ouvre les deux fichiers dans l’application choisie. Applications installées : %@. Le réglage Automatique choisit la première encore installée."
